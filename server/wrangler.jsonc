{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "console-network",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "TERMINALS",
        "class_name": "TerminalRoom"
      }
    ]
  },
  "exports": {
    "TerminalRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
